# Config de la aplicación SimpleLogin — renderizada por install.sh desde .env
# Se monta dentro de los contenedores en /code/.env
# Referencia completa de parámetros: ../../example.env

# URL pública del webapp
URL=__URL__

# Dominio usado para crear alias
EMAIL_DOMAIN=__ROOT_DOMAIN__

# Remitente de los emails transaccionales
SUPPORT_EMAIL=__SUPPORT_EMAIL__

# Los dominios propios de los usuarios deben apuntar a estos MX
EMAIL_SERVERS_WITH_PRIORITY=[(10, "__APP_HOSTNAME__.")]

# En self-hosted no interesa el sufijo aleatorio ".{palabra}" en los alias
DISABLE_ALIAS_SUFFIX=1

# Clave privada DKIM (montada en /dkim.key)
DKIM_PRIVATE_KEY_PATH=/dkim.key

# Conexión a la base de datos (servicio "db" de la red de compose)
DB_URI=postgresql://__DB_USER__:__DB_PASSWORD__@db:5432/__DB_NAME__

FLASK_SECRET=__FLASK_SECRET__
PARTNER_API_TOKEN_SECRET=__PARTNER_API_TOKEN_SECRET__

# Almacenamiento de claves PGP (volumen ./data/pgp)
GNUPGHOME=/sl/pgp

# Subida de ficheros al disco local en vez de S3 (volumen ./data/upload)
LOCAL_FILE_UPLOAD=1

# Postfix corre como contenedor "postfix" en la misma red
POSTFIX_SERVER=postfix
POSTFIX_PORT=25

# Sin emails de onboarding en instancias self-hosted
DISABLE_ONBOARDING=true

# Resolutores DNS usados por la app
NAMESERVERS=1.1.1.1

ALLOWED_REDIRECT_DOMAINS=[]

# Cuando termines de crear tus cuentas, cierra el registro:
#   ./manage.sh disable-registration
# DISABLE_REGISTRATION=1

# Si tu ISP bloquea el puerto 25 saliente y usas relay con TLS en 587:
# POSTFIX_PORT=587
# POSTFIX_SUBMISSION_TLS=true
