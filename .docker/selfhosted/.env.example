# ─────────────────────────────────────────────────────────────────────────────
# Configuración del despliegue dockerizado de SimpleLogin
# Copia este fichero a  .env  y edítalo, o ejecuta  ./install.sh  (interactivo).
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominios ────────────────────────────────────────────────────────────────
# Dominio con el que se crean los alias (el MX apunta aquí).   ej: example.com
ROOT_DOMAIN=
# Host del webapp y objetivo del MX (registro A -> IP).        ej: app.example.com
APP_HOSTNAME=
# Remitente de los emails transaccionales.                     ej: support@example.com
SUPPORT_EMAIL=

# ── Red ─────────────────────────────────────────────────────────────────────
# IP pública del servidor para el registro A. Vacío = autodetección.
SERVER_IP=

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
DB_USER=simplelogin
DB_NAME=simplelogin
# Vacío = se genera con  openssl rand -hex 16
DB_PASSWORD=

# ── Aplicación ──────────────────────────────────────────────────────────────
# Vacío = se genera con  openssl rand -hex 32
FLASK_SECRET=
PARTNER_API_TOKEN_SECRET=
# http | https   (install.sh lo pone a https en los modos caddy/traefik)
URL_SCHEME=http

# ── Reverse proxy / TLS ────────────────────────────────────────────────────
# simple  = sin proxy, webapp en 127.0.0.1:7777 (tú pones el tuyo delante)
# caddy   = contenedor Caddy   con HTTPS automático (Let's Encrypt)
# traefik = contenedor Traefik con HTTPS automático (Let's Encrypt)
DEPLOY_MODE=simple
# Email para Let's Encrypt (obligatorio en modo caddy o traefik)
ACME_EMAIL=
# 1 = levanta también el cron de mantenimiento
ENABLE_CRON=0

# ── Postfix ────────────────────────────────────────────────────────────────
# 1 = abre también el puerto de submission 587 (STARTTLS)
POSTFIX_SUBMISSION=0
# Relay SMTP saliente. Rellénalo si tu ISP/VPS bloquea el puerto 25 SALIENTE.
# ej: [smtp.gmail.com]:587   /   [email-smtp.eu-west-1.amazonaws.com]:587
RELAY_HOST=
RELAY_USER=
RELAY_PASSWORD=

# ── Cloudflare (opcional) ──────────────────────────────────────────────────
# Si defines un token, install.sh crea/actualiza los registros DNS por API.
# Permisos del token:  Zone.DNS:Edit  +  Zone.Zone:Read
CF_API_TOKEN=
# Nombre de la zona en Cloudflare (normalmente == ROOT_DOMAIN). Vacío = autodetección.
CF_ZONE_NAME=
